ANTHROPIC_API_KEY=sk-ant-api-여기에_본인_키_입력
CLAUDE_MODEL=claude-sonnet-4-6

# 심사위원 피드백 — 노션 '서류평가 피드백 모음' 표 동기화용
# (scripts/sync_notion_feedback.py 실행 시 사용)
NOTION_API_KEY=ntn_여기에_노션_통합_토큰_입력
NOTION_FEEDBACK_PAGE_ID=표가_들어있는_노션_페이지_ID_32자리

# ── 회원 인증 ────────────────────────────────────────────────────────────
# 로그인 쿠키·이메일 인증·비밀번호 재설정 토큰 서명키 (32자 이상, 필수)
# 미설정 시 서버가 기동되지 않는다.
# 생성: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=여기에_64자_랜덤_hex_입력

# 인증 링크에 들어갈 서비스 주소. 운영에서는 https:// 로 시작해야
# 로그인 쿠키에 Secure 플래그가 자동으로 붙는다.
APP_BASE_URL=http://localhost:3000

# 계정 DB 경로. Railway는 반드시 Volume 마운트 경로를 지정할 것 —
# 미지정 시 재배포마다 전 회원 계정이 사라진다. (예: /data/bizplan.db)
DB_PATH=data/bizplan.db

# 이메일 발송 (Resend). 미설정 시 발송하지 않고 링크를 로그에만 남긴다(로컬 개발용).
RESEND_API_KEY=re_여기에_Resend_API_키_입력
MAIL_FROM=noreply@본인도메인

# ── 결제 언락 ────────────────────────────────────────────────────────────
# scripts/issue_unlock_code.py로 코드 발급 시 사용
UNLOCK_SECRET=여기에_언락코드_서명키_입력
