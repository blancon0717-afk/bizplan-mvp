# ── Notion ─────────────────────────────────────────────────────────────────────
# Integration Token: https://www.notion.so/my-integrations 에서 발급
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 사업계획서 DB의 ID (노션 DB URL 에서 추출)
# 예: https://www.notion.so/workspace/3a4871f3603246... → 3a4871f3-6032-46...
NOTION_DB_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Anthropic ──────────────────────────────────────────────────────────────────
# API Key: https://console.anthropic.com/settings/keys
# score_plan.py, main.py 모두 이 키 사용 (모델: claude-haiku-4-5-20251001)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Sheets (선택) ────────────────────────────────────────────────────────
# 서비스 계정 JSON 파일의 절대 경로 또는 상대 경로
# GCP Console → IAM → 서비스계정 → 키 생성 → JSON 다운로드
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

# 결과를 저장할 구글 시트 ID (URL 중간 /d/xxxxxxx/edit 부분)
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 저장할 시트(탭) 이름
GOOGLE_SHEET_NAME=Sheet1

# ── Pipeline 파라미터 (선택) ───────────────────────────────────────────────────
# 0 = 전체, 양수 = 최근 N건만 처리 (개발/테스트 시 소수로 시작 권장)
SAMPLE_SIZE=0

# Anthropic API 동시 요청 수 (기본값 3, API limit 초과 주의)
CONCURRENCY=3
